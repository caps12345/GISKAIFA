<Window x:Class="WpfMapApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        xmlns:local="clr-namespace:WpfMapApp2"
        mc:Ignorable="d"
        Title="南京15分钟医疗生活圈 - 公共卫生应急响应系统" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 蓝色主题样式 -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModuleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="BorderBrush" Value="#BBDEFB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                    <Setter Property="BorderBrush" Value="#64B5F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#90CAF9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E3F2FD"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 占位符样式 -->
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="2">
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <TextBlock x:Name="placeholderTextBlock"
                                       Text="输入小区名称..."
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#999999"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholderTextBlock" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 主布局 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶部菜单栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 模块工具栏 -->
            <RowDefinition Height="*"/>
            <!-- 地图区域 -->
        </Grid.RowDefinitions>

        <!-- 顶部菜单栏 -->
        <Border Grid.Row="0" Background="#1565C0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏥" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="南京公共卫生应急响应系统" 
                          Foreground="White" 
                          FontSize="18" 
                          FontWeight="Bold"
                          VerticalAlignment="Center"/>

                <!-- 简单的垂直线分隔符 -->
                <Rectangle Width="1" Height="24" Fill="#64B5F6" Margin="30,0,20,0"/>

                <!-- 功能模块菜单 -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnResourceSearch" Content="医疗资源检索" 
                            Style="{StaticResource BlueButtonStyle}" 
                            Click="ModuleButton_Click"/>
                    <Button x:Name="BtnCoverageAnalysis" Content="可达性分析" 
                            Style="{StaticResource BlueButtonStyle}" 
                            Click="ModuleButton_Click"/>
                    <Button x:Name="BtnPressureMonitor" Content="供需压力监测" 
                            Style="{StaticResource BlueButtonStyle}" 
                            Click="ModuleButton_Click"/>
                    <Button x:Name="BtnRiskSimulation" Content="⏱️ 风险模拟" 
                            Style="{StaticResource BlueButtonStyle}" 
                            Click="ModuleButton_Click"
                            Background="#1976D2"
                            BorderBrush="#0D47A1"
                            BorderThickness="0,0,0,2"/>
                    <Button x:Name="BtnSmartLocation" Content="智能选址" 
                            Style="{StaticResource BlueButtonStyle}" 
                            Click="ModuleButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 模块工具栏（当前模块的功能按钮） -->
        <Border Grid.Row="1" Background="#F5F9FF" BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel x:Name="ModuleToolbar" Orientation="Horizontal">
                <!-- 风险模拟模块的工具栏 -->
                <StackPanel x:Name="RiskSimulationTools" Orientation="Horizontal">
                    <TextBlock Text="风险模拟工具：" Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="BtnNeighborhoodDiffusion" Content="邻域扩散" 
                            Style="{StaticResource ModuleButtonStyle}"
                            Click="RiskSimulationButton_Click"/>
                    <Button x:Name="BtnNetworkDiffusion" Content="网络扩散" 
                            Style="{StaticResource ModuleButtonStyle}"
                            Click="RiskSimulationButton_Click"
                            IsEnabled="False"/>
                    <Button x:Name="BtnLockdownZone" Content="封控圈生成" 
                            Style="{StaticResource ModuleButtonStyle}"
                            Click="RiskSimulationButton_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 地图视图 -->
        <Grid Grid.Row="2">
            <esri:MapView x:Name="MyMapView" 
                         Map="{Binding Map}"
                         GeoViewTapped="MyMapView_GeoViewTapped"
                         GraphicsOverlays="{Binding HospitalOverlays}" />

            <!-- 邻域扩散控制面板（悬浮在右上角） -->
            <Border x:Name="DiffusionControlPanel" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    Margin="15" 
                    Width="320"
                    Style="{StaticResource PanelBorderStyle}"
                    Visibility="Collapsed">
                <StackPanel Margin="10">
                    <!-- 面板标题 -->
                    <Border Background="#E3F2FD" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🏘️ 邻域扩散模拟" 
                                      FontWeight="Bold" 
                                      FontSize="14"
                                      Foreground="#1565C0"/>
                            <TextBlock Text="模拟疫情在社区内部的接触式传播" 
                                      FontSize="11" 
                                      Foreground="#666"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 小区搜索 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="小区搜索定位" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CommunitySearchBox" 
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     Padding="6"
                                     BorderBrush="#BBDEFB"
                                     BorderThickness="1"
                                     KeyDown="CommunitySearchBox_KeyDown"/>
                            <Button x:Name="BtnSearchCommunity" 
                                    Content="搜索" 
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    Background="#2196F3"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="10,5"
                                    Click="BtnSearchCommunity_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- 操作提示 -->
                    <Border Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,15">
                        <TextBlock Text="请在地图上点击选择扩散起点 或 搜索小区定位" 
                                  FontSize="11" 
                                  TextWrapping="Wrap"
                                  Foreground="#E65100"/>
                    </Border>

                    <!-- 扩散参数 -->
                    <StackPanel>
                        <TextBlock Text="扩散参数设置" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="初始半径 (米)" FontSize="12" Foreground="#555"/>
                                <TextBox x:Name="InitRadiusBox" 
                                         Text="500" 
                                         Margin="0,4,0,10"
                                         Padding="6"
                                         BorderBrush="#BBDEFB"
                                         BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每日增量 (米)" FontSize="12" Foreground="#555"/>
                                <TextBox x:Name="DailyIncrBox" 
                                         Text="200" 
                                         Margin="0,4,0,10"
                                         Padding="6"
                                         BorderBrush="#BBDEFB"
                                         BorderThickness="1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 时间滑块 -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="扩散时间轴" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>

                        <Slider x:Name="DaySlider" 
                               Minimum="0" 
                               Maximum="7" 
                               TickFrequency="1" 
                               IsSnapToTickEnabled="True" 
                               Value="0" 
                               ValueChanged="DaySlider_ValueChanged"
                               Margin="0,5"
                               Foreground="#2196F3"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                            <Border Background="#E3F2FD" CornerRadius="12" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="第" Foreground="#1565C0" FontWeight="Medium"/>
                                    <TextBlock x:Name="DayText" Text="0" Foreground="#1565C0" FontWeight="Bold" Margin="2,0,2,0"/>
                                    <TextBlock Text="天" Foreground="#1565C0" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFF3E0" CornerRadius="12" Padding="8,4" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="扩散半径：" Foreground="#E65100" FontWeight="Medium"/>
                                    <TextBlock x:Name="RadiusText" Text="500" Foreground="#E65100" FontWeight="Bold" Margin="2,0,2,0"/>
                                    <TextBlock Text="米" Foreground="#E65100" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 状态信息 -->
                    <Border Background="#F5F9FF" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="📊 实时统计" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,5"/>
                            <TextBlock x:Name="StatusText" 
                                      Text="等待选择扩散起点..." 
                                      FontSize="12" 
                                      TextWrapping="Wrap"
                                      Foreground="#666"/>
                        </StackPanel>
                    </Border>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="重置模拟" 
                                Background="#F5F5F5" 
                                Foreground="#666"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Padding="10,5"
                                Click="ResetSimulation_Click"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>