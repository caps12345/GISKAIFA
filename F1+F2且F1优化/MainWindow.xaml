<Window x:Class="WpfMapApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        xmlns:local="clr-namespace:WpfMapApp2"
        mc:Ignorable="d"
        Title="南京公共卫生应急响应系统" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TechButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0097FB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,8"/>
        </Style>

        <Style x:Key="LegendRect" TargetType="Rectangle">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Stroke" Value="#555"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <local:MapViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" BorderBrush="#007ACC" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                    <TextBlock Text="🌍 南京市公共卫生应急响应系统" Foreground="White" FontSize="20" FontWeight="ExtraBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">
                    <Button Content="F1 资源感知" Command="{Binding SwitchModuleCommand}" CommandParameter="F1">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F1">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F2 可达性分析" Command="{Binding SwitchModuleCommand}" CommandParameter="F2">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F2">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F3 压力监测" Command="{Binding SwitchModuleCommand}" CommandParameter="F3">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F3">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="0,0,1,0" Visibility="{Binding LeftPanelVisibility}">
                <StackPanel Margin="15">
                    <TextBlock Text="功能控制台" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    <Border Background="#333" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#00FF00" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Visibility="{Binding IsF1ConfigVisible}">
                        <TextBlock Text="1. 智能检索" Style="{StaticResource SectionHeader}"/>
                        <Border Background="White" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" BorderThickness="0" Background="Transparent" Foreground="Black">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock IsHitTestVisible="False" Text="输入医院或小区..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="🔍" Background="Transparent" BorderThickness="0" Foreground="#333" Padding="10,0"/>
                            </Grid>
                        </Border>
                        <Border Background="White" CornerRadius="2" MaxHeight="200" Visibility="{Binding IsShowingResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#333"/>
                                            <TextBlock Text="{Binding DetailInfo}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Text="2. 区域筛选" Style="{StaticResource SectionHeader}"/>
                        <ComboBox ItemsSource="{Binding Districts}" SelectedItem="{Binding SelectedDistrict}" Height="35"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsF2ConfigVisible}">
                        <TextBlock Text="1. 等时圈设置" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="出行方式:" Foreground="#AAA" Margin="0,0,0,3"/>
                        <ComboBox SelectedIndex="{Binding SelectedModeIndex}" Height="30" Margin="0,0,0,10">
                            <ComboBoxItem Content="🚶 老年人 (步行)"/>
                            <ComboBoxItem Content="🚗 年轻人 (驾车)"/>
                        </ComboBox>
                        <TextBlock Text="医院范围:" Foreground="#AAA" Margin="0,0,0,3"/>
                        <ComboBox SelectedIndex="{Binding SelectedHospitalTypeIndex}" Height="30" Margin="0,0,0,10">
                            <ComboBoxItem Content="🏥 仅三甲医院"/>
                            <ComboBoxItem Content="🏥 全部等级医院"/>
                        </ComboBox>
                        <Button Content="📍 加载等时圈分析" Command="{Binding LoadAnalysisCommand}" Style="{StaticResource TechButtonStyle}" Height="35" Margin="0,5,0,15"/>

                        <Border Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="等时圈图例 (分钟)" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <StackPanel Visibility="{Binding LegendWalkL1}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#6DBF85"/>
                                        <TextBlock Text="5 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#9CDFA8"/>
                                        <TextBlock Text="10 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#CEF0D3"/>
                                        <TextBlock Text="15 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding LegendDriveL1}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#7096C4"/>
                                        <TextBlock Text="5 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#9EBCDE"/>
                                        <TextBlock Text="10 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#D4E4F5"/>
                                        <TextBlock Text="15 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding LegendWalkAll}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#EBE05E"/>
                                        <TextBlock Text="5 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#FFF994"/>
                                        <TextBlock Text="10 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#FFFFD1"/>
                                        <TextBlock Text="15 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding LegendDriveAll}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#EBAA36"/>
                                        <TextBlock Text="5 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#FFCE85"/>
                                        <TextBlock Text="10 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#FFEBC2"/>
                                        <TextBlock Text="15 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="2. 盲区分析" Style="{StaticResource SectionHeader}"/>
                        <Button Content="👁‍🗨 识别当前盲区" Command="{Binding CalcBlindSpotCommand}" Style="{StaticResource TechButtonStyle}" Height="40"/>

                        <TextBlock Text="3. 统计分析" Style="{StaticResource SectionHeader}"/>
                        <Button Content="📊 计算区域覆盖率 >>" Command="{Binding CalcEquityCommand}" Style="{StaticResource TechButtonStyle}" Height="40" Background="#2E7D32"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <esri:MapView x:Name="MapView" Map="{Binding Map}" GraphicsOverlays="{Binding GraphicsOverlays}" />

                <Border Background="#CCFFFFFF" CornerRadius="8" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Padding="15" Width="220" BorderBrush="#DDD" BorderThickness="1" Visibility="{Binding F1StatsVisibility}">
                    <StackPanel>
                        <TextBlock Text="区域医疗资源统计" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center" Foreground="#333"/>
                        <Grid Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Fill="#E53935" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="三甲医院" VerticalAlignment="Center" Foreground="#333"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Level1Count}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#E53935"/>
                        </Grid>
                        <ProgressBar Value="{Binding Level1Count}" Maximum="37" Height="6" Foreground="#E53935" Background="#EEE" BorderThickness="0"/>
                        <Grid Margin="0,15,0,5">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Fill="#1296db" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="综合医院" VerticalAlignment="Center" Foreground="#333"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Level2Count}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1296db"/>
                        </Grid>
                        <ProgressBar Value="{Binding Level2Count}" Maximum="179" Height="6" Foreground="#1296db" Background="#EEE" BorderThickness="0"/>
                        <Grid Margin="0,15,0,5">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Fill="#bfbfbf" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="社区医院" VerticalAlignment="Center" Foreground="#333"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Level3Count}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#bfbfbf"/>
                        </Grid>
                        <ProgressBar Value="{Binding Level3Count}" Maximum="513" Height="6" Foreground="#9CDFA8" Background="#EEE" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Width="350" Visibility="{Binding StatsPanelVisibility}" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📊 区域公平性报表" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DistrictStats}" Height="200" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#252526" RowBackground="#2D2D30" Foreground="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#444">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行政区" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="覆盖率" Binding="{Binding RateText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="📈 可视化对比" Style="{StaticResource SectionHeader}" Margin="0,20,0,10"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DistrictStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="#CCC" VerticalAlignment="Center" FontSize="12"/>
                                        <Border Grid.Column="1" Height="12" Background="#333" CornerRadius="2" Margin="5,0"/>
                                        <Border Grid.Column="1" Height="12" CornerRadius="2" Margin="5,0" HorizontalAlignment="Left" Width="{Binding BarWidth}" Background="{Binding BarColor}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RateText}" Foreground="White" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>