<Window x:Class="WpfMapApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        xmlns:local="clr-namespace:WpfMapApp2"
        mc:Ignorable="d"
        Title="南京公共卫生应急响应系统" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TechButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0097FB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,8"/>
        </Style>

        <Style x:Key="LegendRect" TargetType="Rectangle">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Stroke" Value="#555"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <local:MapViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" BorderBrush="#007ACC" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                    <TextBlock Text="🌍 南京市公共卫生应急响应系统" Foreground="White" FontSize="20" FontWeight="ExtraBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">
                    <Button Content="F1 资源感知" Command="{Binding SwitchModuleCommand}" CommandParameter="F1">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F1">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F2 可达性分析" Command="{Binding SwitchModuleCommand}" CommandParameter="F2">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F2">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F3 压力监测" Command="{Binding SwitchModuleCommand}" CommandParameter="F3">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F3">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F4 风险模拟" Command="{Binding SwitchModuleCommand}" CommandParameter="F4">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F4">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F5 决策选址" Command="{Binding SwitchModuleCommand}" CommandParameter="F5">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F5">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="0,0,1,0" Visibility="{Binding LeftPanelVisibility}">
                <StackPanel Margin="15">
                    <TextBlock Text="功能控制台" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    <Border Background="#333" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#00FF00" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Visibility="{Binding IsF1ConfigVisible}">
                        <TextBlock Text="1. 智能检索" Style="{StaticResource SectionHeader}"/>
                        <Border Background="White" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Text="{Binding HospitalSearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" BorderThickness="0" Background="Transparent" Foreground="Black">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding HospitalSearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Command="{Binding HospitalSearchCommand}" Content="🔍" Background="Transparent" BorderThickness="0" Foreground="#333" Padding="10,0"/>
                            </Grid>
                        </Border>
                        <Border Background="White" CornerRadius="2" MaxHeight="200" Visibility="{Binding IsShowingHospitalResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox ItemsSource="{Binding HospitalSearchResults}" SelectedItem="{Binding SelectedHospital}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#333"/>
                                            <TextBlock Text="{Binding DetailInfo}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <TextBlock Text="2. 区域筛选" Style="{StaticResource SectionHeader}"/>
                        <ComboBox ItemsSource="{Binding Districts}" SelectedItem="{Binding SelectedDistrict}" Height="35"/>

                        <TextBlock Text="3. 最近路网就医路径" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="* 查找小区，自动规划三级路径" Foreground="#666" FontSize="11" Margin="0,-5,0,8"/>
                        <Border Background="White" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding CommunitySearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" BorderThickness="0" Background="Transparent" Foreground="Black">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding CommunitySearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Command="{Binding CommunitySearchCommand}" Content="🛣️" Background="Transparent" BorderThickness="0" Foreground="#333" Padding="10,0"/>
                            </Grid>
                        </Border>
                        <Border Background="White" CornerRadius="2" MaxHeight="200" Visibility="{Binding IsShowingCommunityResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox ItemsSource="{Binding CommunitySearchResults}" SelectedItem="{Binding SelectedCommunity}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#333"/>
                                            <TextBlock Text="{Binding DetailInfo}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <ItemsControl ItemsSource="{Binding NearestPaths}" Margin="0,10,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252526" CornerRadius="4" Margin="0,0,0,8" Padding="10" BorderBrush="#444" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="4" Background="{Binding ColorCode}" CornerRadius="2" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding TypeName}" Foreground="#AAA" FontSize="11"/>
                                                <TextBlock Text="{Binding TargetHospitalName}" Foreground="White" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DistanceText}" Foreground="#0097FB" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#2C2C2C" CornerRadius="4" Padding="10" Margin="0,5,0,10" BorderBrush="#FF4444" BorderThickness="1" 
        Visibility="{Binding IsPathLegendVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="🚑 120 急救模拟" FontWeight="Bold" Foreground="#FF6666" Margin="0,0,0,8" FontSize="13"/>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="预计往返时间:" Foreground="#CCC" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EmergencyTimeText}" Foreground="#00FF00" FontWeight="Bold" FontSize="14"/>
                                </Grid>

                                <Button Content="🚨 呼叫最近急救车" Command="{Binding StartEmergencyCommand}" 
                Background="#D32F2F" Foreground="White" FontWeight="Bold" 
                BorderThickness="0" Padding="10,6" Margin="0,5,0,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock Text="* 模拟从最近三甲医院发车" Foreground="Gray" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsF2ConfigVisible}">
                        <TextBlock Text="1. 等时圈设置" Style="{StaticResource SectionHeader}"/>
                        <ComboBox SelectedIndex="{Binding SelectedModeIndex}" Height="30" Margin="0,0,0,10">
                            <ComboBoxItem Content="🚶 老年人 (步行)"/>
                            <ComboBoxItem Content="🚗 年轻人 (驾车)"/>
                        </ComboBox>
                        <ComboBox SelectedIndex="{Binding SelectedHospitalTypeIndex}" Height="30" Margin="0,0,0,10">
                            <ComboBoxItem Content="🏥 仅三甲医院"/>
                            <ComboBoxItem Content="🏥 全部等级医院"/>
                        </ComboBox>
                        <Button Content="📍 加载等时圈分析" Command="{Binding LoadAnalysisCommand}" Style="{StaticResource TechButtonStyle}" Height="35" Margin="0,5,0,15"/>

                        <Border Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="等时圈图例 (分钟)" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <StackPanel Visibility="{Binding LegendWalkL1}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#6DBF85"/>
                                        <TextBlock Text="5 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#9CDFA8"/>
                                        <TextBlock Text="10 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#CEF0D3"/>
                                        <TextBlock Text="15 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding LegendDriveL1}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#7096C4"/>
                                        <TextBlock Text="5 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#9EBCDE"/>
                                        <TextBlock Text="10 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#D4E4F5"/>
                                        <TextBlock Text="15 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding LegendWalkAll}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#EBE05E"/>
                                        <TextBlock Text="5 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#FFF994"/>
                                        <TextBlock Text="10 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#FFFFD1"/>
                                        <TextBlock Text="15 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding LegendDriveAll}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#EBAA36"/>
                                        <TextBlock Text="5 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#FFCE85"/>
                                        <TextBlock Text="10 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Style="{StaticResource LegendRect}" Fill="#FFEBC2"/>
                                        <TextBlock Text="15 min" Foreground="#CCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="2. 盲区分析" Style="{StaticResource SectionHeader}"/>
                        <Button Content="👁‍🗨 识别当前盲区" Command="{Binding CalcBlindSpotCommand}" Style="{StaticResource TechButtonStyle}" Height="40"/>
                        <TextBlock Text="3. 统计分析" Style="{StaticResource SectionHeader}"/>
                        <Button Content="📊 计算区域覆盖率 >>" Command="{Binding CalcEquityCommand}" Style="{StaticResource TechButtonStyle}" Height="40" Background="#2E7D32"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsF3ConfigVisible}">
                        <TextBlock Text="资源供需压力监测" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#252526" Padding="10" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="诊断模式:" Foreground="#AAA" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="rbModeA" Content="综合基础" IsChecked="True" GroupName="Mode" Foreground="White" Margin="0,0,15,0"/>
                                    <RadioButton x:Name="rbModeB" Content="高端紧缺" GroupName="Mode" Foreground="#FF5252"/>
                                </StackPanel>
                                <ComboBox x:Name="cbDiseaseType" SelectedIndex="0" Height="30" Margin="0,0,0,10">
                                    <ComboBoxItem Content="日常综合 (General)" Tag="General"/>
                                    <ComboBoxItem Content="急危重症 (Critical)" Tag="Critical"/>
                                    <ComboBoxItem Content="呼吸/传染 (Infectious)" Tag="Infectious"/>
                                </ComboBox>
                                <Button Content="🚀 开始分层诊断分析" Click="BtnAnalyze_Click" Style="{StaticResource TechButtonStyle}" Height="40"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="可视化图层" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="chkIDW" Content="IDW 插值" IsChecked="True" Checked="IDWLayer_Checked" Unchecked="IDWLayer_Unchecked" Foreground="White"/>
                            <CheckBox x:Name="chkKDE" Content="KDE 核密度" Grid.Column="1" IsChecked="False" Checked="KDELayer_Checked" Unchecked="KDELayer_Unchecked" Foreground="White"/>
                        </Grid>

                        <Border x:Name="ReportPanel" Background="#E3F2FD" CornerRadius="4" Padding="10" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📊 区域诊断报告" FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                                    <Button Content="刷新" Click="BtnReport_Click" Background="Transparent" Foreground="#1565C0" BorderThickness="0" Margin="10,0,0,0" FontSize="10"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtHighPressureRatio" Text="--" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center"/>
                                        <TextBlock Text="高压占比" FontSize="10" Foreground="#555" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Rectangle Grid.Column="1" Width="1" Fill="#CCC" Margin="0,5"/>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtAffectedPop" Text="--" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center"/>
                                        <TextBlock Text="受累人口(万)" FontSize="10" Foreground="#555" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="⚠️ 资源最紧缺区域 Top 3" FontSize="11" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
                                <StackPanel x:Name="pnlRankingContainer"/>
                            </StackPanel>
                        </Border>
                        <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="2" Margin="0,10" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsF4ConfigVisible}">
                        <TextBlock Text="1. 锁定零号小区 (全局)" Style="{StaticResource SectionHeader}" Foreground="#FF4081"/>
                        <Border Background="White" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding F4SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" BorderThickness="0" Background="Transparent" Foreground="Black">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding F4SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Command="{Binding F4SearchCommand}" Content="🔍" Background="Transparent" BorderThickness="0" Foreground="#333" Padding="10,0"/>
                            </Grid>
                        </Border>

                        <Border Background="White" CornerRadius="2" MaxHeight="120" Visibility="{Binding IsShowingF4Results, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox ItemsSource="{Binding F4SearchResults}" SelectedItem="{Binding SelectedF4Community}" BorderThickness="0" MaxHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#333"/>
                                            <TextBlock Text="{Binding DetailInfo}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,15" HorizontalAlignment="Center">
                            <Button Content="邻域扩散" Command="{Binding SwitchF4ModeCommand}" CommandParameter="Neighborhood" Margin="5,0" Padding="10,5" Style="{StaticResource NavButtonStyle}"/>
                            <Button Content="网络扩散" Command="{Binding SwitchF4ModeCommand}" CommandParameter="Network" Margin="5,0" Padding="10,5" Style="{StaticResource NavButtonStyle}"/>
                            <Button Content="封控圈" Command="{Binding SwitchF4ModeCommand}" CommandParameter="Lockdown" Margin="5,0" Padding="10,5" Style="{StaticResource NavButtonStyle}"/>
                        </StackPanel>

                        <Border Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,15" Visibility="{Binding IsNeighborhoodModeVisible}">
                            <StackPanel>
                                <TextBlock Text="时间轴控制" Style="{StaticResource SectionHeader}"/>
                                <Slider Value="{Binding CurrentDay, Mode=TwoWay}" Minimum="0" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,5"/>
                                <TextBlock Text="{Binding CurrentDay, StringFormat={}Day {0}}" Foreground="#CCC" HorizontalAlignment="Center"/>
                                <TextBlock Text="初始半径: 200m | 增长: 200m/天" Foreground="Gray" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,15" Visibility="{Binding IsNetworkModeVisible}">
                            <StackPanel>
                                <TextBlock Text="目标医院信息" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding NearestHospitalInfo}" Foreground="#00FF00" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="模拟参数: 真实路况 + 多策略 (API)" Foreground="Gray" FontSize="10" Margin="0,0,0,10"/>
                                <Button Content="🚀 开始真实路径模拟" Command="{Binding StartNetworkSimulationCommand}" Style="{StaticResource TechButtonStyle}" Height="35"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentF4Mode}" Value="Lockdown">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="智能决策支持" Style="{StaticResource SectionHeader}"/>
                                <Button Content="🛡️ 生成封控圈方案" Command="{Binding GenerateLockdownCommand}" Style="{StaticResource TechButtonStyle}" Background="#D32F2F" FontSize="14" FontWeight="Bold" Height="45"/>
                                <TextBlock Text="生成逻辑: 邻域缓冲区 + 风险走廊" Foreground="Gray" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsF5ConfigVisible}">
                        <TextBlock Text="1. 盲区识别" Style="{StaticResource SectionHeader}"/>

                        <ComboBox SelectedIndex="{Binding SelectedF5HospitalTypeIndex}" Height="35" Margin="0,0,0,10">
                            <ComboBoxItem Content="🏥 仅三甲医院 (高端缺口)"/>
                            <ComboBoxItem Content="🏥 全部等级医院 (基础缺口)"/>
                        </ComboBox>

                        <Button Content="👁‍🗨 识别当前盲区" Command="{Binding CalcBlindSpotCommand}" Style="{StaticResource TechButtonStyle}" Height="40" Margin="0,0,0,15"/>

                        <TextBlock Text="2. 智能选址推荐" Style="{StaticResource SectionHeader}"/>
                        <Button Content="⚙️ 开始计算最优选址" Command="{Binding StartOptimizationCommand}" Style="{StaticResource TechButtonStyle}" Height="40" Margin="0,0,0,15"/>

                        <ItemsControl ItemsSource="{Binding OptimizationResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2D2D30" CornerRadius="4" Margin="0,5" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#0097FB" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding LocationDesc}" Foreground="#CCC" FontSize="11" Margin="0,2"/>
                                            <TextBlock Text="{Binding PopulationDesc}" Foreground="#CCC" FontSize="11" Margin="0,2"/>
                                            <TextBlock Text="{Binding Suggestion}" Foreground="#4CAF50" FontSize="12" Margin="0,5"/>
                                            <Button Content="定位" Command="{Binding DataContext.ZoomToSiteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding CenterPoint}" Style="{StaticResource TechButtonStyle}" HorizontalAlignment="Right" Width="60"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <esri:MapView x:Name="MapView" Map="{Binding Map}" GraphicsOverlays="{Binding GraphicsOverlays}" />

                <Border Background="#CCFFFFFF" CornerRadius="8" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Padding="15" Width="220" BorderBrush="#DDD" BorderThickness="1" Visibility="{Binding F1StatsVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatsTitle}" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center" Foreground="#333"/>
                        
                        <Grid Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Fill="#E53935" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="三甲医院" VerticalAlignment="Center" Foreground="#333"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Level1Count}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#E53935"/>
                        </Grid>
                        <ProgressBar Value="{Binding Level1Count}" Maximum="37" Height="6" Foreground="#E53935" Background="#EEE" BorderThickness="0"/>

                        <Grid Margin="0,15,0,5">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Fill="#1296db" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="综合医院" VerticalAlignment="Center" Foreground="#333"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Level2Count}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1296db"/>
                        </Grid>
                        <ProgressBar Value="{Binding Level2Count}" Maximum="179" Height="6" Foreground="#1296db" Background="#EEE" BorderThickness="0"/>

                        <Grid Margin="0,15,0,5">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="社区医院" VerticalAlignment="Center" Foreground="#333"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Level3Count}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#4CAF50"/>
                        </Grid>
                        <ProgressBar Value="{Binding Level3Count}" Maximum="513" Height="6" Foreground="#4CAF50" Background="#EEE" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Width="350" Visibility="{Binding StatsPanelVisibility}" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="📊 区域公平性报表" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DistrictStats}" Height="200" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#252526" RowBackground="#2D2D30" Foreground="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#444">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行政区" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="覆盖率" Binding="{Binding RateText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="📈 可视化对比" Style="{StaticResource SectionHeader}" Margin="0,20,0,10"/>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DistrictStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}" Foreground="#CCC" VerticalAlignment="Center" FontSize="12"/>

                                        <Border Grid.Column="1" Height="12" Background="#333" CornerRadius="2" Margin="5,0"/>
                                        <Border Grid.Column="1" Height="12" CornerRadius="2" Margin="5,0" 
                                                HorizontalAlignment="Left" 
                                                Width="{Binding BarWidth}" 
                                                Background="{Binding BarColor}"/>

                                        <TextBlock Grid.Column="2" Text="{Binding RateText}" Foreground="White" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>