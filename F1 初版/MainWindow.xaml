<Window x:Class="WpfMapApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        xmlns:local="clr-namespace:WpfMapApp2"
        mc:Ignorable="d"
        Title="南京公共卫生应急响应系统" Height="700" Width="1000">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1976D3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="0,4,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <local:MapViewModel />
    </Window.DataContext>

    <Grid>
        <esri:MapView x:Name="MapView" 
                      Map="{Binding Map}" 
                      GraphicsOverlays="{Binding HospitalOverlays}" />

        <Border Background="White" 
                CornerRadius="6"
                VerticalAlignment="Top" 
                HorizontalAlignment="Left"
                Margin="20"
                Padding="15"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Width="280">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="南京公共卫生应急响应系统" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#333"
                           Margin="0,0,0,8"/>

                <Separator Background="#EEE" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="系统状态：" FontWeight="Bold" Foreground="#555"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="#1976D3" 
                               FontWeight="SemiBold"
                               MaxWidth="180"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="图层图例：" FontWeight="Bold" Foreground="#555" Margin="0,0,5,0"/>
                    <Rectangle Width="14" Height="14" Fill="#32FF0000" Stroke="Red" StrokeThickness="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="南京市行政边界" Foreground="#333" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,20,0" Width="320">
            <Border Background="White" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="区域筛选:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="#666"/>
                    <ComboBox Grid.Column="1" 
                      ItemsSource="{Binding Districts}" 
                      SelectedItem="{Binding SelectedDistrict}"
                      BorderThickness="0" 
                      Padding="5,8"
                      Background="Transparent"
                      VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
            <Border Background="White" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" 
                             Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14" Padding="10,8" BorderThickness="0"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock IsHitTestVisible="False" 
                               Grid.Column="0"
                               Text="搜索医院或小区..." 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left" 
                               Margin="10,0,0,0" 
                               Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1" 
                        Command="{Binding SearchCommand}"
                        Content="🔍" 
                        FontSize="16"
                        Style="{StaticResource SearchButtonStyle}"
                        Cursor="Hand" />
                </Grid>
            </Border>

            <Border Background="White" Margin="0,2,0,0" CornerRadius="2" BorderBrush="#DDD" BorderThickness="1"
                    Visibility="{Binding IsShowingResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox ItemsSource="{Binding SearchResults}" 
                         SelectedItem="{Binding SelectedResult}"
                         MaxHeight="400" 
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5,8">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#333"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="#E3F2FD" CornerRadius="2" Padding="4,1">
                                        <TextBlock Text="{Binding Type}" FontSize="10" Foreground="#1976D3"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
        <Border Background="#CCFFFFFF" 
        CornerRadius="8" 
        VerticalAlignment="Bottom" 
        HorizontalAlignment="Right" 
        Margin="0,0,20,20" 
        Padding="15" 
        Width="220"
        BorderBrush="#DDD" 
        BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="当前视野内医疗资源" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <Grid Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="12" Fill="#E53935" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="三甲医院" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Level1Count}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#E53935"/>
                </Grid>
                <ProgressBar Value="{Binding Level1Count}" Maximum="20" Height="8" Foreground="#E53935" Background="#EEE" BorderThickness="0"/>

                <Grid Margin="0,15,0,5">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="12" Fill="#43A047" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="社区医院" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Level2Count}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#43A047"/>
                </Grid>
                <ProgressBar Value="{Binding Level2Count}" Maximum="200" Height="8" Foreground="#43A047" Background="#EEE" BorderThickness="0"/>

                <TextBlock Text="* 移动地图自动更新数据" FontSize="10" Foreground="#999" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>