<Window x:Class="WpfMapApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        xmlns:local="clr-namespace:WpfMapApp2"
        mc:Ignorable="d"
        Title="南京公共卫生应急响应系统" Height="700" Width="1000">

    <Window.DataContext>
        <local:MapViewModel />
    </Window.DataContext>

    <Grid>
        <esri:MapView x:Name="MapView" 
              Map="{Binding Map}" 
              GraphicsOverlays="{Binding HospitalOverlays}" />
        
        <Border Background="White" 
                CornerRadius="6"
                VerticalAlignment="Top" 
                HorizontalAlignment="Left"
                Margin="20"
                Padding="15"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="南京公共卫生应急响应系统" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#333"
                           Margin="0,0,0,8"/>

                <Separator Background="#EEE" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="系统状态：" FontWeight="Bold" Foreground="#555"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="#1976D3" 
                               FontWeight="SemiBold"
                               MaxWidth="250"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="图层图例：" FontWeight="Bold" Foreground="#555" Margin="0,0,5,0"/>
                    <Rectangle Width="14" Height="14" Fill="#32FF0000" Stroke="Red" StrokeThickness="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="南京市行政边界" Foreground="#333" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>