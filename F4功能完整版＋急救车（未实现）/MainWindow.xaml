<Window x:Class="WpfMapApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        xmlns:local="clr-namespace:WpfMapApp2"
        mc:Ignorable="d"
        Title="南京公共卫生应急响应系统" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TechButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0097FB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,8"/>
        </Style>

        <Style x:Key="LegendRect" TargetType="Rectangle">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Stroke" Value="#555"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <local:MapViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" BorderBrush="#007ACC" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                    <TextBlock Text="🌍 南京市公共卫生应急响应系统" Foreground="White" FontSize="20" FontWeight="ExtraBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">
                    <Button Content="F1 资源感知" Command="{Binding SwitchModuleCommand}" CommandParameter="F1">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F1">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F2 可达性分析" Command="{Binding SwitchModuleCommand}" CommandParameter="F2">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F2">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F3 压力监测" Command="{Binding SwitchModuleCommand}" CommandParameter="F3">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F3">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F4 风险模拟" Command="{Binding SwitchModuleCommand}" CommandParameter="F4">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F4">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="F5 急救响应" Command="{Binding SwitchModuleCommand}" CommandParameter="F5">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="F5">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="0,0,1,0" Visibility="{Binding LeftPanelVisibility}">
                <StackPanel Margin="15">
                    <TextBlock Text="功能控制台" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    <Border Background="#333" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#00FF00" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Visibility="{Binding IsF1ConfigVisible}">
                        <TextBlock Text="1. 智能检索" Style="{StaticResource SectionHeader}"/>
                        <Border Background="White" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" BorderThickness="0" Background="Transparent" Foreground="Black">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="🔍" Background="Transparent" BorderThickness="0" Foreground="#333" Padding="10,0"/>
                            </Grid>
                        </Border>
                        <Border Background="White" CornerRadius="2" MaxHeight="200" Visibility="{Binding IsShowingResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#333"/>
                                            <TextBlock Text="{Binding DetailInfo}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <TextBlock Text="2. 区域筛选" Style="{StaticResource SectionHeader}"/>
                        <ComboBox ItemsSource="{Binding Districts}" SelectedItem="{Binding SelectedDistrict}" Height="35"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsF2ConfigVisible}">
                        <TextBlock Text="1. 等时圈设置" Style="{StaticResource SectionHeader}"/>
                        <ComboBox SelectedIndex="{Binding SelectedModeIndex}" Height="30" Margin="0,0,0,10">
                            <ComboBoxItem Content="🚶 老年人 (步行)"/>
                            <ComboBoxItem Content="🚗 年轻人 (驾车)"/>
                        </ComboBox>
                        <Button Content="📍 加载等时圈分析" Command="{Binding LoadAnalysisCommand}" Style="{StaticResource TechButtonStyle}" Height="35" Margin="0,5,0,15"/>
                        <TextBlock Text="2. 盲区分析" Style="{StaticResource SectionHeader}"/>
                        <Button Content="👁‍🗨 识别当前盲区" Command="{Binding CalcBlindSpotCommand}" Style="{StaticResource TechButtonStyle}" Height="40"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsF4ConfigVisible}">
                        <TextBlock Text="1. 锁定零号小区 (全局)" Style="{StaticResource SectionHeader}" Foreground="#FF4081"/>
                        <Border Background="White" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding F4SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" BorderThickness="0" Background="Transparent" Foreground="Black">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding F4SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Command="{Binding F4SearchCommand}" Content="🔍" Background="Transparent" BorderThickness="0" Foreground="#333" Padding="10,0"/>
                            </Grid>
                        </Border>
                        <Border Background="White" CornerRadius="2" MaxHeight="120" Visibility="{Binding IsShowingF4Results, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox ItemsSource="{Binding F4SearchResults}" SelectedItem="{Binding SelectedF4Community}" BorderThickness="0" MaxHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#333"/>
                                            <TextBlock Text="{Binding DetailInfo}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,15" HorizontalAlignment="Center">
                            <Button Content="邻域扩散" Command="{Binding SwitchF4ModeCommand}" CommandParameter="Neighborhood" Margin="5,0" Padding="10,5" Style="{StaticResource NavButtonStyle}"/>
                            <Button Content="网络扩散" Command="{Binding SwitchF4ModeCommand}" CommandParameter="Network" Margin="5,0" Padding="10,5" Style="{StaticResource NavButtonStyle}"/>
                            <Button Content="封控圈" Command="{Binding SwitchF4ModeCommand}" CommandParameter="Lockdown" Margin="5,0" Padding="10,5" Style="{StaticResource NavButtonStyle}"/>
                        </StackPanel>

                        <Border Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,15" Visibility="{Binding IsNeighborhoodModeVisible}">
                            <StackPanel>
                                <TextBlock Text="时间轴控制" Style="{StaticResource SectionHeader}"/>
                                <Slider Value="{Binding CurrentDay, Mode=TwoWay}" Minimum="0" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,5"/>
                                <TextBlock Text="{Binding CurrentDay, StringFormat={}Day {0}}" Foreground="#CCC" HorizontalAlignment="Center"/>
                                <TextBlock Text="初始半径: 200m" Foreground="Gray" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,15" Visibility="{Binding IsNetworkModeVisible}">
                            <StackPanel>
                                <TextBlock Text="目标医院信息" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding NearestHospitalInfo}" Foreground="#00FF00" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="模拟参数: 真实路况 + 多策略" Foreground="Gray" FontSize="10" Margin="0,0,0,10"/>
                                <Button Content="🚀 开始真实路径模拟" Command="{Binding StartNetworkSimulationCommand}" Style="{StaticResource TechButtonStyle}" Height="35"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentF4Mode}" Value="Lockdown">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="智能决策支持" Style="{StaticResource SectionHeader}"/>
                                <Button Content="🛡️ 生成封控圈方案" Command="{Binding GenerateLockdownCommand}" Style="{StaticResource TechButtonStyle}" Background="#D32F2F" FontSize="14" FontWeight="Bold" Height="45"/>
                                <TextBlock Text="包含: 高风险核心区 + 中低风险防范区" Foreground="Gray" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <esri:MapView x:Name="MapView" Map="{Binding Map}" GraphicsOverlays="{Binding GraphicsOverlays}" />

                <Border Background="#CCFFFFFF" CornerRadius="8" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Padding="15" Width="220" BorderBrush="#DDD" BorderThickness="1" Visibility="{Binding F1StatsVisibility}">
                    <StackPanel>
                        <TextBlock Text="当前视野资源统计" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center" Foreground="#333"/>
                        <TextBlock Text="{Binding Level1Count, StringFormat=三甲医院: {0}}" Foreground="#E53935" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Level2Count, StringFormat=社区医院: {0}}" Foreground="#43A047" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0" 
                        Background="#D9000000" CornerRadius="10" Padding="20,10"
                        Visibility="{Binding IsRescueDashboardVisible}" BorderBrush="{Binding RescueDashboardColor}" BorderThickness="3">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.6"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="16" Height="16" CornerRadius="8" Background="{Binding RescueDashboardColor}" Margin="0,0,15,0" VerticalAlignment="Top">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="{Binding RescueDashboardText}" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Width="350" Visibility="{Binding StatsPanelVisibility}" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📊 区域公平性报表" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DistrictStats}" Height="200" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#252526" RowBackground="#2D2D30" Foreground="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#444">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行政区" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="覆盖率" Binding="{Binding RateText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>